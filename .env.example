# Optional overrides. The app uses ESPN's public, unauthenticated endpoints by default.
# No API key is required for scores or the highlights strip.

# ESPN_WEB_BASE=https://site.web.api.espn.com/apis/site/v2/sports/football/college-football
# ESPN_SITE_BASE=https://site.api.espn.com/apis/site/v2/sports/football/college-football

# Optional. Highlights default to public YouTube channel RSS (no key).
# Set this only if you want YouTube Data API search mixed into the strip.
# When RSS is down and this is unset, the strip shows SAMPLE-labeled cards — never fake scores.
# YOUTUBE_API_KEY=

# Reserved for a later third-party odds feed. Deep Dive v0 does not read this.
# Prop cards already render without live odds. When ESPN’s public pickcenter
# includes a line (often DraftKings), that published market is shown as-is.
# ODDS_API_KEY=
